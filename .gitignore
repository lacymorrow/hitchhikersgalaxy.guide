# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*

# local env files (LAC-3468 / LAC-3470)
# Deny every dotenv variant, then explicitly allow the shared example.
.env
.env.*
!.env.example

# Nested / renamed .git directories (LAC-3470).
# LAC-3468 originated when a committed `.gittt/` shipped a live `.env` inside
# a mirror of the working tree — no `.env` glob catches that. Deny the
# renamed-.git shapes we have seen, and any nested `.git/` under the tree.
.gittt/
.git-old/
.git.bak/
.git.old/
.git-backup/
**/.git/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Build output
dist/
build/

# Cache
.cache/
.eslintcache

# Logs
*.log

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
