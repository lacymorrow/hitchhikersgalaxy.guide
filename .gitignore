# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/testing-results
/test-results
/coverage

# next.js
/.next/
/out/

# generated content manifests (created by scripts/prebuild-content.mjs)
src/lib/generated/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*

# local env files
env
*.env*
!.env.example

# vercel
.vercel

# Secret-scan hygiene (LAC-3163)
# .specstory persists chat transcripts that captured live tokens in past commits.
.specstory/
# repomix outputs bundle repo contents and have leaked secrets historically.
.repomix-output.*
repomix-output.*

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Build output
dist/
build/

# Cache
.cache/
.eslintcache

# Environment variables
env/*
*.env*
!.env.example

# # Logs
# logs
*.log

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
.env*.local

# From bones sync
.idea/
env/
logs

# fumadocs-mdx generated collections
.source

# mirrored from docs/images by scripts/sync-docs-images.mjs
public/docs
